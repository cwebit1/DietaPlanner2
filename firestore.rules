rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function permitted(userId) {
      return request.auth != null && request.auth.uid == userId
        && exists(/databases/$(database)/documents/access/$(userId))
        && get(/databases/$(database)/documents/access/$(userId)).data.role in ['admin', 'user'];
    }
    match /access/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Ruoli assegnati da amministrazione server, mai dal client.
      allow write: if false;
    }
    match /users/{userId} {
      allow read, create, update: if permitted(userId);
      allow delete: if false;

      match /{document=**} {
        allow read, write: if permitted(userId);
      }
    }
  }
}
